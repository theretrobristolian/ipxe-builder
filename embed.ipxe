#!ipxe

# Tiny embedded bootstrap for legacy BIOS iPXE.
#
# Mirror the iPXE 2.0.0 autoexec discovery behaviour used by the official UEFI
# binaries: first look alongside the boot binary, then fall back to the TFTP
# root.  The TFTP server address comes entirely from DHCP via next-server.
#
# This builder deliberately publishes the legacy BIOS binary as:
#   non-efi/ipxe.pxe
# so its adjacent autoexec location is:
#   non-efi/autoexec.ipxe

dhcp || goto failed

isset ${next-server} || goto no_server

chain tftp://${next-server}/non-efi/autoexec.ipxe ||
chain tftp://${next-server}/autoexec.ipxe || goto failed

:no_server
echo
echo DHCP did not provide a TFTP next-server.
echo Dropping to iPXE shell.
shell

:failed
echo
echo Unable to load autoexec.ipxe from either:
echo   tftp://${next-server}/non-efi/autoexec.ipxe
echo   tftp://${next-server}/autoexec.ipxe
echo Dropping to iPXE shell.
shell
